PORT=5000
NODE_ENV=development
JWT_SECRET=changez-moi-en-production-secret-long
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# For Cloud Run, set PORT=8080 in the Cloud Run environment
UPLOAD_MAX_MB=10

# Supabase Storage (la clé service_role reste uniquement côté backend)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
SUPABASE_STORAGE_BUCKET=cabcomptable-files

# SMTP pour les e-mails transactionnels
SMTP_HOST=smtp.exemple.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-utilisateur-smtp
SMTP_PASSWORD=votre-mot-de-passe-smtp
SMTP_FROM=CabComptable <noreply@exemple.com>
CONTACT_EMAIL=adresse-du-cabinet@exemple.com
PASSWORD_RESET_EXPIRES_MINUTES=30

# Firebase Admin / Firestore (obligatoire pour utiliser Firebase)
# FIREBASE_PROJECT_ID=votre-projet
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
